{
  "name": "codeshark-academy",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "assets:badges": "node scripts/generate-badge-sprites.mjs",
    "test:badges": "node scripts/test-badge-sprites.mjs",
    "db:tidb:init": "node --env-file-if-exists=.env scripts/tidb-db.mjs init",
    "db:tidb:check": "node --env-file-if-exists=.env scripts/tidb-db.mjs check",
    "dev:api": "node --env-file-if-exists=.env server/dev-api.mjs",
    "test:tidb": "node --test tests/tidb.test.mjs tests/sync.test.mjs",
    "test:netlify": "node --test tests/netlify.test.mjs",
    "db:verify": "node --env-file-if-exists=.env scripts/verify-database.mjs",
    "test:database-status": "node --test tests/database-status.test.mjs",
    "db:settings:init": "node --env-file-if-exists=.env scripts/init-site-settings.mjs",
    "test:settings": "node --test tests/site-settings.test.mjs",
    "test:settings:browser": "node scripts/test-settings-browser.mjs",
    "auth:verify": "node --env-file-if-exists=.env scripts/verify-auth.mjs",
    "test:auth": "node --test tests/supabase-auth.test.mjs",
    "test:admin-setup": "node --test tests/admin-setup.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "2.1.1",
    "matter-js": "^0.20.0",
    "mysql2": "^3.24.6",
    "p5": "^2.3.4",
    "pixi.js": "^8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "sql.js": "^1.14.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/matter-js": "^0.20.2",
    "@types/node": "22.19.17",
    "@types/p5": "^1.7.7",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "5.1.1",
    "playwright-core": "^1.64.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
