# Template only: fill project values in ignored .env or deployment environment.
# Never commit actual credentials, including project-specific public configuration.
# ============================================================
# MODE DATA OTOMATIS — lihat docs/036_mode-lokal_26102026_0819.md
# Saat aplikasi dibuka, sistem MENGETES koneksi ke cloud DB
# (TiDB Cloud dan/atau Aiven) lewat /api/database-status:
#   tes berhasil  → mode CLOUD (sinkron ke provider terpilih)
#   tes gagal     → mode LOKAL (SQLite/localStorage perangkat)
# Isi kredensial provider yang dipakai saja; yang kosong akan
# dianggap tidak terkonfigurasi oleh tes awal.
# ============================================================

# --- Saklar mode ---
# auto (default) = tes awal menentukan · local = paksa lokal · cloud = paksa cloud
VITE_DATA_MODE=auto
DATA_MODE=auto
# Halaman admin tetap nonaktif pada mode auto/local.
VITE_ADMIN_ENABLED=false
# Opsional: paksa prioritas provider (tidb|aiven). Kosong = deteksi otomatis
# (TiDB didahulukan, lalu Aiven) berdasarkan kredensial yang terisi.
DB_PROVIDER=

# --- TiDB Cloud (MySQL protocol) ---
# Server only — never prefix database secrets with VITE_.
# Verify readiness: npm run db:verify (read-only; does not create tables).
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=codeshark
# Optional CA: choose PEM content (Netlify secret) OR a local PEM file path.
# Leave both empty to use the Node.js trusted public CA store.
# GitHub CA upload: add certs/tidb-ca-rozanhaisyam.pem, then set TIDB_CA_PATH=certs/tidb-ca-rozanhaisyam.pem.
TIDB_CA_CERT=
TIDB_CA_PATH=certs/tidb-ca-rozanhaisyam.pem
# Development-only anonymous testing; ignored when NODE_ENV=production.
TIDB_ALLOW_GUEST_SYNC=false
API_PORT=3001

# --- Better Auth (Layerbase MariaDB "Auth Server") ---
# Database KHUSUS autentikasi (tabel user/session/account/verification),
# TERPISAH dari database game TiDB/Aiven. Ambil connection string dari
# Layerbase dashboard → Connect. Nama yang diminta Layerbase adalah
# DATABASE_URL; AUTH_DATABASE_URL diutamakan bila keduanya diisi.
DATABASE_URL=
AUTH_DATABASE_URL=
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL aplikasi TANPA path /api/auth (lokal: http://localhost:3000;
# produksi: https://domain-anda). Wajib sama dengan origin deployment.
BETTER_AUTH_URL=
# Public origin opsional untuk klien browser; kosong = origin yang sama
# dengan halaman (disarankan untuk Netlify/Vercel satu domain).
VITE_BETTER_AUTH_URL=
# Dinamis untuk preview (opsional, pisah koma): *.vercel.app,latihan.my.id
BETTER_AUTH_ALLOWED_HOSTS=
BETTER_AUTH_TRUSTED_ORIGINS=
# CA kustom Layerbase/MariaDB (PEM) bila penyedia mewajibkannya.
AUTH_DB_CA_CERT=
AUTH_DB_SSL_REJECT_UNAUTHORIZED=true

# --- Aiven (PostgreSQL atau MySQL) — database GAME ---
# postgres://user:pass@host.aivencloud.com:port/db?sslmode=require  (driver pg)
# mysql://user:pass@host.aivencloud.com:port/db                     (driver mysql2)
# JANGAN memakai DATABASE_URL untuk Aiven MySQL — nama itu milik Better Auth.
AIVEN_DATABASE_URL=
GAME_DATABASE_URL=
NETLIFY_DATABASE_URL=
# CA proyek Aiven (PEM) — sangat disarankan agar TLS terverifikasi penuh.
AIVEN_CA_CERT=

# --- Redis cache (OPSIONAL — akselerasi serverless, bukan database utama) ---
# Berbagi cache hasil tes koneksi + site-settings antar-instance fungsi
# (TTL 30 dtk). Tanpa Redis, cache in-memory per-instance yang dipakai.
# Pilihan A (disarankan di Netlify/Vercel): Upstash Redis REST
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pilihan B: TCP — Aiven for Valkey/Redis, Redis Cloud, dll (rediss:// disarankan)
REDIS_URL=

# Token rahasia untuk membuka tes koneksi mendalam di /admin/
# (header x-admin-token). Alternatif login Google admin (ADMIN_USER_IDS).
# Kosongkan untuk menonaktifkan jalur token. JANGAN prefix VITE_.
ADMIN_TEST_TOKEN=

# Legacy/optional: verifikasi JWT Supabase untuk sesi lama (bukan Supabase DB).
# Login email/password baru memakai Better Auth di atas.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional legacy key fallback; leave empty when using a publishable key.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public browser configuration — NEVER put database credentials here.
VITE_SITE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy anon key fallback. Never use a secret/service-role key here.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SYNC_ENDPOINT=/api/sync-progress

# Server-only: comma-separated verified auth user IDs allowed to administer the website.
ADMIN_USER_IDS=

# Server-only: optional privileged API key; not needed for user JWT verification.
# A masked example is NOT a usable key. Leave blank unless a privileged operation needs it.
SUPABASE_SECRET_KEY=
# Enables @supabase/server user-JWT verification. Must match the Supabase project URL.
SUPABASE_JWKS_URL=
