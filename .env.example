# ============ CodeShark Academy — template env ============
# Salin ke .env untuk lokal, atau isi satu-per-satu di dashboard
# Netlify (Site settings → Environment) / Vercel (Project → Settings → Environment).
# JANGAN commit file .env asli. Yang boleh di-commit hanya .env.example ini.
#
# CHECKLIST LOGIN GOOGLE (Supabase Auth):
#  1. npm i @supabase/supabase-js   (tanpa ini tombol login tidak aktif, game tetap jalan guest)
#  2. Isi VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY di bawah
#  3. Supabase Dashboard → Authentication → Providers → Google → ON,
#     isi Client ID + Client Secret dari Google Cloud Console
#     (APIs & Services → Credentials → OAuth client ID).
#     Kunci Google TIDAK ditulis di file ini — cukup di dashboard Supabase.
#  4. Supabase Dashboard → Authentication → URL Configuration:
#     Site URL = domain produksi (mis. https://latihan.my.id)
#     Redirect URLs += https://latihan.my.id/**  (dan http://localhost:5173/** untuk dev)
#     Kode memakai redirectTo = window.location.origin, jadi origin harus terdaftar di sini.
#  5. Supabase SQL Editor → jalankan db/supabase-schema.sql sekali (tabel + RLS owner-only).

# ---------- FRONTEND (Vite — wajib prefix VITE_, terbaca browser) ----------
# WAJIB untuk login Google. Tanpa ini: isCloudReady()=false, game 100% lokal/guest.
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSJ9.PASTE_ANON_PUBLIC_KEY

# Opsional: override endpoint sinkronisasi (default /api/sync-progress).
# Kosongkan bila full-Supabase (tulis langsung via RLS, tanpa function).
VITE_SYNC_ENDPOINT=/api/sync-progress

# Opsional: origin kanonis untuk OAuth redirect (dokumentasi saja;
# kode memakai window.location.origin saat runtime).
VITE_SITE_URL=http://localhost:5173

# ---------- SERVER / FUNCTION SAJA (tanpa prefix — JANGAN pakai VITE_) ----------
# Jalur Neon legacy (dipakai api/sync-progress.mjs). Tidak perlu bila sudah full-Supabase.
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/codeshark?sslmode=require
# Netlify memakai nama ini bila DATABASE_URL tidak ada (kode membaca keduanya).
NETLIFY_DATABASE_URL=

# Opsional — hanya bila function perlu verifikasi token / tulis admin ke Supabase.
# SERVICE_ROLE_KEY = rahasia server, TIDAK BOLEH diawali VITE_ (bocor ke browser).
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
