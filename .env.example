# Server only — never prefix database secrets with VITE_.
DB_PROVIDER=tidb
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DATABASE=codeshark
# Optional CA: choose PEM content (Netlify secret) OR a local PEM file path.
# Leave both empty to use the Node.js trusted public CA store.
# GitHub CA upload: add certs/tidb-ca-rozanhaisyam.pem, then set TIDB_CA_PATH=certs/tidb-ca-rozanhaisyam.pem.
TIDB_CA_CERT=
TIDB_CA_PATH=
# Development-only anonymous testing; ignored when NODE_ENV=production.
TIDB_ALLOW_GUEST_SYNC=false
API_PORT=3001

# Server token verification for TiDB sync (Supabase Auth, not Supabase DB).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy Neon/PostgreSQL configuration (DB_PROVIDER other than tidb).
DATABASE_URL=
NETLIFY_DATABASE_URL=

# Public browser configuration — NEVER put database credentials here.
VITE_SITE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SYNC_ENDPOINT=/api/sync-progress
